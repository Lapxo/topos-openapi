{
  "name": "@lapxo/topos-openapi",
  "version": "0.1.0",
  "private": true,
  "description": "A world of APIs built on topos: any OpenAPI 3 document read as a lock, its operations as forms and its methods as declared effects, never as proven ones.",
  "type": "module",
  "license": "MIT",
  "author": "Lapxo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lapxo/topos-openapi.git"
  },
  "keywords": [
    "topos",
    "world",
    "openapi",
    "effects"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.15"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "TARGET.bound"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@lapxo/topos": "0.1.12",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
